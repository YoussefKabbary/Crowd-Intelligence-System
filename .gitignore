# Virtual environment
venv/
__pycache__/
*.py[cod]

# Model weights — downloaded by ultralytics on first run, not source
*.pt
*.onnx

# Trained checkpoints. The CNN regressor is off by default and its checkpoint
# is a per-deployment artifact, not something to ship.
*.pth

# Runtime data and generated artifacts
DATA/replay_buffer.pkl
DATA/*.log
DATA/crowd_log.csv
DATA/drift_events.csv
DATA/crowd_report.*
DATA/crowd_report_report.png
DATA/snapshots/
DATA/events/

# Labelled frames produced by tools/extract_frames.py
*_labels/

# Local scratch
install_torch.txt
*.mp4
v1_reference/
DATA/_demo/
